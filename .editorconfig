root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4
trim_trailing_whitespace = true
indent_brace_style = K&R
max_line_length = 160
curly_bracket_next_line = false
spaces_around_brackets = inside
continuation_indent_size = 4

[*.md]
trim_trailing_whitespace = false

[*.{sh}]
indent_size = 2

[*.{yml,yaml}]
indent_size = 4

[*.{js,ts}]
quote_type = single

[*.html]
quote_type = double
